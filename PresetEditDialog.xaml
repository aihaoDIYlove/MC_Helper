<Window x:Class="MC_Helper.PresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑方案"
        Width="380" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent">

    <Border CornerRadius="14" Background="#E81C1C1E"
            BorderBrush="#3A3A3C" BorderThickness="1" Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2C2C2E" CornerRadius="14,14,0,0"
                    Padding="16,12" MouseLeftButtonDown="TitleBar_Drag">
                <TextBlock x:Name="TitleLabel" Text="编辑方案"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"/>
            </Border>

            <StackPanel Grid.Row="1" Margin="20,14,20,0">
                <TextBlock Text="方案名称" Foreground="#EBEBF5" FontSize="13"
                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtName" Height="32" Margin="0,0,0,14"
                         Background="#2C2C2E" Foreground="#EBEBF5"
                         BorderBrush="#48484A" BorderThickness="1"
                         FontFamily="Segoe UI" FontSize="13" Padding="8,4"/>

                <TextBlock Text="鼠标按键" Foreground="#EBEBF5" FontSize="13"
                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbLeft" Content="左键" GroupName="Button"
                                 Foreground="#EBEBF5" FontSize="13" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RbRight" Content="右键" GroupName="Button"
                                 Foreground="#EBEBF5" FontSize="13"/>
                </StackPanel>

                <TextBlock Text="点击行为" Foreground="#EBEBF5" FontSize="13"
                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbRapid" Content="连点" GroupName="Behavior"
                                 Foreground="#EBEBF5" FontSize="13" Margin="0,0,20,0"
                                 Checked="OnBehaviorChanged"/>
                    <RadioButton x:Name="RbHold" Content="长按" GroupName="Behavior"
                                 Foreground="#EBEBF5" FontSize="13"
                                 Checked="OnBehaviorChanged"/>
                </StackPanel>

                <TextBlock Text="快捷键行为" Foreground="#EBEBF5" FontSize="13"
                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <RadioButton x:Name="RbTrigToggle" Content="开关" GroupName="TriggerMode"
                                 Foreground="#EBEBF5" FontSize="13" Margin="0,0,20,0"/>
                    <RadioButton x:Name="RbTrigHold" Content="按住启用" GroupName="TriggerMode"
                                 Foreground="#EBEBF5" FontSize="13"/>
                </StackPanel>

                <Grid x:Name="RapidSettings">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="连点间隔 (ms)" Foreground="#98989D" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtIntervalMs" Width="100" Height="30"
                                 Background="#2C2C2E" Foreground="#EBEBF5"
                                 BorderBrush="#48484A" BorderThickness="1"
                                 FontFamily="Segoe UI" FontSize="13" Padding="8,4"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="按下持续 (ms)" Foreground="#98989D" FontSize="11" Margin="0,0,0,2"/>
                        <TextBox x:Name="TxtHoldMs" Width="100" Height="30"
                                 Background="#2C2C2E" Foreground="#EBEBF5"
                                 BorderBrush="#48484A" BorderThickness="1"
                                 FontFamily="Segoe UI" FontSize="13" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Border Grid.Row="2" Background="#2C2C2E" CornerRadius="0,0,14,14" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消"
                            Background="Transparent" Foreground="#98989D" BorderBrush="#48484A"
                            Width="70" Height="36" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button Content="确定"
                            Background="#0A84FF" Foreground="#FFFFFF" BorderBrush="Transparent"
                            Width="70" Height="36" Click="BtnOk_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
