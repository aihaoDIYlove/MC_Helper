<UserControl x:Class="MC_Helper.Panels.ClickToolPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24">

    <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                 Fill="#FF453A" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF453A" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock x:Name="StatusLabel" Text="未启动"
                   Foreground="#98989D" FontSize="11" FontFamily="Segoe UI"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>

        <TextBlock Text="方案:" Foreground="#98989D" FontSize="11"
                   FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox x:Name="PresetCombo" Width="120" Height="20"
                  FontSize="10" FontFamily="Segoe UI"
                  Foreground="#EBEBF5" Background="#3A3A3C" BorderBrush="#48484A"
                  SelectionChanged="PresetCombo_SelectionChanged">
            <ComboBox.Template>
                <ControlTemplate TargetType="ComboBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="6,2">
                        <Grid>
                            <TextBlock x:Name="DisplayText"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center" FontSize="10"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#2C2C2E" BorderBrush="#48484A"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="3" Margin="0,3,0,0">
                                    <ScrollViewer MaxHeight="140">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </ComboBox.Template>
        </ComboBox>
    </StackPanel>
</UserControl>
