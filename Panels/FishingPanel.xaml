<UserControl x:Class="MC_Helper.Panels.FishingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24">

    <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                 Fill="#FF453A" Margin="0,0,6,0" VerticalAlignment="Center">
            <Ellipse.Effect>
                <DropShadowEffect Color="#FF453A" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
            </Ellipse.Effect>
        </Ellipse>
        <TextBlock x:Name="StateLabel" Text="等待启用检测"
                   Foreground="#98989D" FontSize="11" FontFamily="Segoe UI"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>

        <Button x:Name="BtnSelect" Content="⛶"
                Width="22" Height="20" FontSize="13" FontFamily="Segoe UI"
                Click="BtnSelect_Click" Cursor="Hand"
                ToolTip="框选 OCR 截图区域">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#98989D"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="4" Padding="3,1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3A3A3C"/>
                            <Setter Property="Foreground" Value="#EBEBF5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </StackPanel>
</UserControl>
