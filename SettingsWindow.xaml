<Window x:Class="MC_Helper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MC_Helper 设置"
        Width="720" Height="580"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        Background="Transparent">

    <Window.Resources>
        <!-- ═══ 颜色 Token ─────────────────────── -->
        <SolidColorBrush x:Key="WindowBg" Color="#282929"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#202121"/>
        <SolidColorBrush x:Key="CardBg" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="TextDark" Color="#EDF2F2"/>
        <SolidColorBrush x:Key="TextCard" Color="#EDF2F2"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#98989D"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#60A5FA"/>
        <SolidColorBrush x:Key="BorderLight" Color="#48484A"/>
        <SolidColorBrush x:Key="DangerRed" Color="#FF453A"/>

        <!-- ═══ 字体 ──────────────────────────── -->
        <FontFamily x:Key="UIFont">Segoe UI</FontFamily>

        <!-- ═══ 侧边栏项样式 ──────────────────── -->
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#98989D"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Margin="8,1,8,1">
                            <TextBlock Text="{TemplateBinding Content}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#EBEBF5"/>
                                <Setter Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 卡片标题（段首，最高层级） ────── -->
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#EDF2F2"/>
            <Setter Property="Text" Value=""/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ═══ 设置行标签（中层） ─────────────── -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C7C7CC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ═══ 次级说明文字（最底层） ────────── -->
        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#98989D"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ═══ 文本框（macOS 凹陷风格） ──────── -->
        <Style x:Key="CardTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#EDF2F2"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="OuterBorder"
                                Background="#1A1A1C"
                                BorderBrush="#3A3A3C"
                                BorderThickness="1"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Border x:Name="FocusBorder"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="5"
                                    Margin="-1">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder"
                                        Property="BorderBrush" Value="#5A5A5D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 只读文本框（更低调，用于按键显示） ── -->
        <Style x:Key="ReadOnlyTextBox" TargetType="TextBox"
               BasedOn="{StaticResource CardTextBox}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#1A1A1C"/>
            <Setter Property="Foreground" Value="#98989D"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <!-- ═══ 按钮（主要操作） ──────────────── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 按钮（次要操作 — 灰底白字） ──── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#EDF2F2"/>
            <Setter Property="Background" Value="#4A4A4D"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#5A5A5D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ 小按钮（绑定/编辑等 — 蓝底白字） ── -->
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ RadioButton（扁平） ────────────── -->
        <Style x:Key="FlatRadio" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#EDF2F2"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ═══ CheckBox（扁平） ───────────────── -->
        <Style x:Key="FlatCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#EDF2F2"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ═══ 代码后置引用别名（保持兼容） ──── -->
        <SolidColorBrush x:Key="AppleTextPrimaryBrush" Color="#EDF2F2"/>
        <SolidColorBrush x:Key="AppleTextSecondaryBrush" Color="#98989D"/>

        <Style x:Key="ApplePrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="110"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style x:Key="AppleSecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource SmallButton}">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="28"/>
        </Style>

        <Style x:Key="AppleDangerButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- ═══ 原 CloseButton 继续 ───────────── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="{StaticResource UIFont}"/>
            <Setter Property="Foreground" Value="#86868B"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Width="28" Height="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3C"/>
                                <Setter Property="Foreground" Value="#EDF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══ macOS 风格滚动条 ──────────────── -->
        <Style x:Key="AppleScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Background="#55EDF2F2"
                                CornerRadius="3"
                                SnapsToDevicePixels="True"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background" Value="#88EDF2F2"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder"
                                        Property="Background" Value="#AAEDF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppleScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════
         窗口外框
         ════════════════════════════════════════════ -->
    <Border x:Name="WindowRoot"
            CornerRadius="12"
            Background="{StaticResource WindowBg}"
            BorderBrush="#3A3A3C"
            BorderThickness="1"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40"
                              ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
                <RowDefinition Height="*"/>       <!-- 主体 -->
                <RowDefinition Height="Auto"/>   <!-- 底部按钮栏 -->
            </Grid.RowDefinitions>

            <!-- ═══ 标题栏 ════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#232424"
                    CornerRadius="12,12,0,0"
                    Padding="16,10"
                    MouseLeftButtonDown="TitleBar_Drag">
                <Grid>
                    <TextBlock Text="MC_Helper 设置"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextDark}"
                               VerticalAlignment="Center"/>
                    <Button Content="✕"
                            Style="{StaticResource CloseButton}"
                            HorizontalAlignment="Right"
                            Click="BtnCancel_Click"/>
                </Grid>
            </Border>

            <!-- ═══ 主体：侧边栏 + 内容区 ════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── 侧边栏 ──────────────────── -->
                <Border Grid.Column="0"
                        Background="{StaticResource SidebarBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ListBox x:Name="SidebarList"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 Margin="0,12,0,12"
                                 SelectionChanged="SidebarList_SelectionChanged">
                            <ListBoxItem Style="{StaticResource SidebarItemStyle}"
                                         Tag="general">
                                通用设置
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource SidebarItemStyle}"
                                         Tag="click">
                                点击方案
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource SidebarItemStyle}"
                                         Tag="fishing">
                                钓鱼相关
                            </ListBoxItem>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- ── 右侧内容区 ──────────────── -->
                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              Background="{StaticResource WindowBg}">
                    <Grid Margin="20,16,20,16">
                        <!-- ═══ 通用 页面 ════════════════ -->
                        <StackPanel x:Name="PageGeneral" Visibility="Visible">

                            <!-- 卡片：模式切换 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="模式切换"/>
                                    <TextBlock Style="{StaticResource SubLabel}"
                                               Text="支持单键、组合键、鼠标侧键"
                                               Margin="0,-4,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="上一个模式"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtPrevModeKey"
                                                 Grid.Column="1" Width="130"
                                                 Style="{StaticResource ReadOnlyTextBox}"/>
                                        <Button x:Name="BtnBindPrevMode"
                                                Grid.Column="2"
                                                Content="点击绑定"
                                                Style="{StaticResource SmallButton}"
                                                Width="100" Height="32"
                                                Click="BtnBindPrevMode_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="下一个模式"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtNextModeKey"
                                                 Grid.Column="1" Width="130"
                                                 Style="{StaticResource ReadOnlyTextBox}"/>
                                        <Button x:Name="BtnBindNextMode"
                                                Grid.Column="2"
                                                Content="点击绑定"
                                                Style="{StaticResource SmallButton}"
                                                Width="100" Height="32"
                                                Click="BtnBindNextMode_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="快速启停"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtQuickToggleKey"
                                                 Grid.Column="1" Width="130"
                                                 Style="{StaticResource ReadOnlyTextBox}"/>
                                        <Button x:Name="BtnBindQuickToggle"
                                                Grid.Column="2"
                                                Content="点击绑定"
                                                Style="{StaticResource SmallButton}"
                                                Width="100" Height="32"
                                                Click="BtnBindQuickToggle_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：方案切换 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="方案切换（点击模式）"/>
                                    <TextBlock Style="{StaticResource SubLabel}"
                                               Text="在点击模式下快速切换方案"
                                               Margin="0,-4,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="上一个方案"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtPrevPresetKey"
                                                 Grid.Column="1" Width="130"
                                                 Style="{StaticResource ReadOnlyTextBox}"/>
                                        <Button x:Name="BtnBindPrevPreset"
                                                Grid.Column="2"
                                                Content="点击绑定"
                                                Style="{StaticResource SmallButton}"
                                                Width="100" Height="32"
                                                Click="BtnBindPrevPreset_Click"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="下一个方案"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtNextPresetKey"
                                                 Grid.Column="1" Width="130"
                                                 Style="{StaticResource ReadOnlyTextBox}"/>
                                        <Button x:Name="BtnBindNextPreset"
                                                Grid.Column="2"
                                                Content="点击绑定"
                                                Style="{StaticResource SmallButton}"
                                                Width="100" Height="32"
                                                Click="BtnBindNextPreset_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：Debug 设置 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="Debug 设置"/>
                                    <CheckBox x:Name="ChkDoubleClickTrayExit"
                                              Style="{StaticResource FlatCheck}"
                                              Content="双击托盘图标强制退出"
                                              Margin="0,4,0,0"/>
                                    <CheckBox x:Name="ChkDebugLogInput"
                                              Style="{StaticResource FlatCheck}"
                                              Content="调试日志：输入事件写入 log.txt"
                                              Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ 点击方案 页面 ════════════ -->
                        <StackPanel x:Name="PageClick" Visibility="Collapsed">
                            <StackPanel x:Name="ClickPresetPanel"/>
                        </StackPanel>

                        <!-- ═══ 钓鱼 页面 ════════════════ -->
                        <StackPanel x:Name="PageFishing" Visibility="Collapsed">

                            <!-- 卡片：OCR 截图区域 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="OCR 截图区域"/>
                                    <TextBlock Style="{StaticResource SubLabel}"
                                               Text="屏幕百分比 (0–100)"
                                               Margin="0,-4,0,10"/>
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="X"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtCaptureX"
                                                 Grid.Column="1" Width="80"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Text="Y" Grid.Column="3"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtCaptureY"
                                                 Grid.Column="4" Width="80"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Text="宽" Grid.Row="1"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtCaptureW"
                                                 Grid.Row="1" Grid.Column="1" Width="80"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Text="高" Grid.Row="1" Grid.Column="3"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtCaptureH"
                                                 Grid.Row="1" Grid.Column="4" Width="80"
                                                 Style="{StaticResource CardTextBox}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：检测 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="检测"/>
                                    <TextBlock Text="轮询间隔"
                                               Style="{StaticResource SettingLabel}"
                                               Margin="0,0,0,6"/>
                                    <StackPanel Margin="0,0,0,6">
                                        <RadioButton x:Name="Rb250" GroupName="Polling"
                                                     Style="{StaticResource FlatRadio}"
                                                     Content="250ms - 低开销 4Hz"/>
                                        <RadioButton x:Name="Rb200" GroupName="Polling"
                                                     Style="{StaticResource FlatRadio}"
                                                     Content="200ms - 默认 5Hz"/>
                                        <RadioButton x:Name="Rb125" GroupName="Polling"
                                                     Style="{StaticResource FlatRadio}"
                                                     Content="125ms - 略高开销 8Hz"/>
                                        <RadioButton x:Name="Rb100" GroupName="Polling"
                                                     Style="{StaticResource FlatRadio}"
                                                     Content="100ms - 高开销 10Hz"/>
                                    </StackPanel>
                                    <CheckBox x:Name="ChkAutoFish"
                                              Style="{StaticResource FlatCheck}"
                                              Content="启用自动钓鱼"/>
                                    <CheckBox x:Name="ChkDebugLog"
                                              Style="{StaticResource FlatCheck}"
                                              Content="调试日志：OCR 写入 log.txt"/>
                                    <CheckBox x:Name="ChkDebugOverlay"
                                              Style="{StaticResource FlatCheck}"
                                              Content="实时调试：显示 OCR 文字"/>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,2,0,0">
                                        <TextBlock Text="模糊匹配阈值"
                                                   Style="{StaticResource SettingLabel}"
                                                   Margin="0,0,2,0"/>
                                        <TextBox x:Name="TxtFuzzyThreshold"
                                                 Width="64"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Text="(0.30–1.00，越低越宽松，默认 0.75)"
                                                   Style="{StaticResource SubLabel}"
                                                   Margin="2,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：识别短语 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="识别短语"/>
                                    <TextBlock Style="{StaticResource SubLabel}"
                                               Text="逗号分隔多个短语"
                                               Margin="0,-4,0,8"/>
                                    <TextBlock Text="抛竿短语"
                                               Style="{StaticResource SettingLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtCastPhrases"
                                             MinHeight="52" TextWrapping="Wrap"
                                             Style="{StaticResource CardTextBox}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="咬钩短语"
                                               Style="{StaticResource SettingLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtBitePhrases"
                                             MinHeight="52" TextWrapping="Wrap"
                                             Style="{StaticResource CardTextBox}"
                                             Margin="0,0,0,10"/>
                                    <TextBlock Text="收回短语"
                                               Style="{StaticResource SettingLabel}"
                                               Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtReelPhrases"
                                             MinHeight="52" TextWrapping="Wrap"
                                             Style="{StaticResource CardTextBox}"/>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：延迟设置 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="延迟设置 (ms)"/>
                                    <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="抛竿后冷却"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtCastCooldown"
                                                 Grid.Column="1" Width="60"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource SubLabel}"
                                                   Text="抛竿后此时间内不检测咬钩"
                                                   Margin="10,0,0,0"/>
                                        <TextBlock Text="收回后重抛" Grid.Row="1"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtRecastDelay"
                                                 Grid.Row="1" Grid.Column="1" Width="60"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Style="{StaticResource SubLabel}"
                                                   Text="检测到收回后等待此时间，自动右键抛竿"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：自动切换鱼竿 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="自动切换鱼竿"/>
                                    <CheckBox x:Name="ChkAutoSwitchRod"
                                              Style="{StaticResource FlatCheck}"
                                              Content="启用自动切换鱼竿"
                                              Margin="0,0,0,10"/>

                                    <TextBlock Text="启用鱼竿槽位"
                                               Style="{StaticResource SubLabel}"
                                               Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,14">
                                        <CheckBox x:Name="ChkRod1"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="1" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod2"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="2" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod3"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="3" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod4"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="4" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod5"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="5" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod6"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="6" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod7"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="7" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod8"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="8" Margin="2,0"/>
                                        <CheckBox x:Name="ChkRod9"
                                                  Style="{StaticResource FlatCheck}"
                                                  Content="9" Margin="2,0"/>
                                    </StackPanel>

                                    <Grid HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="36"/>
                                            <RowDefinition Height="36"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="切杆延迟"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtSwitchRodDelay"
                                                 Grid.Column="1" Width="60"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource SubLabel}"
                                                   Text="识别到损坏后，等待此时间再按数字键切杆"
                                                   Margin="10,0,0,0"/>
                                        <TextBlock Text="切杆重抛" Grid.Row="1"
                                                   Style="{StaticResource SettingLabel}"/>
                                        <TextBox x:Name="TxtSwitchRodRecast"
                                                 Grid.Row="1" Grid.Column="1" Width="60"
                                                 Style="{StaticResource CardTextBox}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Style="{StaticResource SubLabel}"
                                                   Text="按下数字键后等待此时间，再右键抛竿"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片：损坏识别短语 -->
                            <Border Background="{StaticResource CardBg}"
                                    CornerRadius="10" Padding="12" ClipToBounds="True"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardHeader}"
                                               Text="损坏识别短语"/>
                                    <TextBlock Style="{StaticResource SubLabel}"
                                               Text="逗号分隔多个短语"
                                               Margin="0,-4,0,8"/>
                                    <TextBox x:Name="TxtBrokenPhrases"
                                             MinHeight="52" TextWrapping="Wrap"
                                             Style="{StaticResource CardTextBox}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ═══ 底部按钮栏 ════════════════════ -->
            <Border Grid.Row="2"
                    Background="#232424"
                    CornerRadius="0,0,12,12"
                    Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel"
                            Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave"
                            Content="保存"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>